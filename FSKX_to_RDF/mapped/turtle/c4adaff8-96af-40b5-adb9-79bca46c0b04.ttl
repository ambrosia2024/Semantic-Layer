    dcterms:rights "Creative Commons Attribution (CC BY)" ;
    dcterms:source "PUBLISHED SCIENTIFIC STUDIES" ;
    dcterms:title "Listeria monocytogenes growth model on iceberg lettuce" ;
    fskxo:FSKXO_0000000004 <http://semanticlookup.zbmed.de/km/fskxo/c4adaff8-96af-40b5-adb9-79bca46c0b04/reference/10_1016_j_ijfoodmicro_2005_02_012> ;
    fskxo:FSKXO_0000000052 "The objective of the model is to predict the growth of Listeria monocytogenes on iceberg lettuce under different temperature conditions." ;
    fskxo:FSKXO_0000017519 fskxo:FSKXO_0000000315,
        fskxo:FSKXO_0000017569 ;
