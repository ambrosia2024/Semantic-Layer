<http://semanticlookup.zbmed.de/km/fskxo/c4adaff8-96af-40b5-adb9-79bca46c0b04/generalInformation> a fskxo:FSKXO_0000050247 ;
    obo:IAO_0000114 "Uncurated" ;
    dcterms:accessRights "true" ;
    dcterms:created "2025-03-26"^^xsd:date ;
    dcterms:creator <http://semanticlookup.zbmed.de/km/fskxo/c4adaff8-96af-40b5-adb9-79bca46c0b04/creator/13e38a6e>,
        <http://semanticlookup.zbmed.de/km/fskxo/c4adaff8-96af-40b5-adb9-79bca46c0b04/creator/d9c71653> ;
    dcterms:description "This model predicts the growth of Listeria monocytogenes on iceberg lettuce using the Baranyi primary growth model with temperature-dependent secondary models for maximum growth rate, lag time, and maximum population density. The model is adapted from the original paper by Koseki and Isobe (2005) which studied pathogen growth on iceberg lettuce under real temperature history during distribution from farm to table." ;
    dcterms:identifier "c4adaff8-96af-40b5-adb9-79bca46c0b04" ;
    dcterms:language fskxo:FSKXO_0000000315 ;
    dcterms:modified "2025-03-28"^^xsd:date ;
    dcterms:rights "Creative Commons Attribution (CC BY)" ;
    dcterms:source "PUBLISHED SCIENTIFIC STUDIES" ;
    fskxo:FSKXO_0000000004 <http://semanticlookup.zbmed.de/km/fskxo/c4adaff8-96af-40b5-adb9-79bca46c0b04/reference/10_1016_j_ijfoodmicro_2005_02_012> ;
    fskxo:FSKXO_0000000049 fskxo:FSKXO_0000017569 ;
    fskxo:FSKXO_0000000052 "The objective of the model is to predict the growth of Listeria monocytogenes on iceberg lettuce under different temperature conditions." ;
    schema:name "Listeria monocytogenes growth model on iceberg lettuce" ;
    schema:programmingLanguage "Python 3.12.9" .

