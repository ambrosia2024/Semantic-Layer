    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0000086">
        <rdfs:comment xml:lang="en">Stub declaration (no import of ro.owl). A relation between an independent continuant (the bearer) and one of its qualities. Source: RO (Relations Ontology); IRI verified 2026-04-10 via OBO PURL and OLS4.</rdfs:comment>
        <rdfs:label xml:lang="en">has quality</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0001025 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0001025">
        <rdfs:comment xml:lang="en">Stub declaration (no import of ro.owl). A relation between two independent continuants, the target and the location, in which the target is entirely within the location. Source: RO (Relations Ontology); IRI verified 2026-04-10 via OBO PURL and OLS4.</rdfs:comment>
        <rdfs:label xml:lang="en">located in</rdfs:label>
    </owl:ObjectProperty>
    


