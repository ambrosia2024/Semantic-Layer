    <owl:Ontology rdf:about="http://semanticlookup.zbmed.de/km/fskxo/">
        <owl:versionIRI rdf:resource="http://semanticlookup.zbmed.de/km/fskxo/2.0.0"/>
        <dcterms:creator>https://ror.org/0259fwx54</dcterms:creator>
        <dcterms:creator>https://ror.org/03k3ky186</dcterms:creator>
        <dcterms:description xml:lang="en">The FSKX ontology contains definitions used in the FSKX (Fair Scientific Knowledge eXchange) context. Its origins lie in the food safety domain (previously known as &apos;Food Safety Knowledge eXchange&apos;). The classes and instances in the FSKX ontology were created from controlled vocabularies in a spreadsheet file named &apos;Controlled_Vocabularies_Master_Table_V1.04&apos; found on the BfR webpage &apos;RAKIP Harmonization Resources&apos;. A hyperlink to the webpage is provided. The properties in the FSKX ontology have been defined to improve working with the controlled vocabularies in a linked data context.</dcterms:description>
        <dcterms:license rdf:resource="https://www.gnu.org/licenses/gpl-3.0"/>
        <dcterms:modified>2026-05-26</dcterms:modified>
        <dcterms:source>https://foodrisklabs.bfr.bund.de/rakip-harmonization-resources/</dcterms:source>
        <owl:versionInfo>2.0.0</owl:versionInfo>
    </owl:Ontology>
    


