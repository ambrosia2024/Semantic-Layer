    <!-- http://semanticlookup.zbmed.de/km/fskxo/FSKXO_0000017815 -->

    <owl:NamedIndividual rdf:about="http://semanticlookup.zbmed.de/km/fskxo/FSKXO_0000017815">
        <rdf:type rdf:resource="http://semanticlookup.zbmed.de/km/fskxo/FSKXO_0000017800"/>
        <obo:IAO_0000115>This defines a representation for vCard data in JavaScript Object Notation (JSON);
The keys of this JSON Object are the same as VCard properties enclosed between double quotes e.g. &quot;fn&quot;:  &quot;Simon Perreault&quot; or &quot;pref&quot;: 1
e.g.:
    {  
    &quot;version&quot;:&quot;4.0&quot;, 
    &quot;fn&quot;:  &quot;Simon Perreault&quot;,
    &quot;n&quot;: {
        &quot;surname&quot;: &quot;Simon&quot;,
        &quot;given&quot;: &quot;Perreault&quot;,
        &quot;suffix&quot;: [ &quot;ing. jr&quot;, &quot;M.Sc.&quot;]
    },
    &quot;email&quot;: {
    &quot;type&quot;: &quot;work&quot;,
    &quot;text&quot;: &quot;simon.perreault@viagenie.ca&quot;
    }
}</obo:IAO_0000115>
        <rdfs:isDefinedBy rdf:resource="http://semanticlookup.zbmed.de/km/fskxo"/>
        <rdfs:label xml:lang="en">VCard</rdfs:label>
    </owl:NamedIndividual>
    


