        <rdf:type rdf:resource="http://semanticlookup.zbmed.de/km/fskxo/FSKXO_0000017800"/>
        <obo:IAO_0000115>RIS information in RIS file format — two letters, two spaces and a hyphen; no quotation mark required, e.g. TY - JOUR
AU - Shannon, Claude E.
PY - 1948/07//
TI - A Mathematical Theory of Communication
T2 - Bell System Technical Journal
SP - 379
EP - 423
VL - 27
ER -https://en.wikipedia.org/wiki/RIS_(file_format</obo:IAO_0000115>
        <rdfs:isDefinedBy rdf:resource="http://semanticlookup.zbmed.de/km/fskxo"/>
        <rdfs:label xml:lang="en">RIS</rdfs:label>
    </owl:NamedIndividual>
    


