amblim:don-provisions a prov:Entity ;
    dct:identifier "Annex: entry 1.4.1, maximum column and remarks; Articles 2 and 3" ;
    dct:description "Maximum 1000 micrograms/kg. General cereal entry excludes categories 1.4.2/1.4.3, rice and specified wet-milling maize. Applies from 1 July 2024. Previously lawfully marketed food may remain until minimum durability/use-by; this catalogue does not resolve transitional eligibility." ;
    dct:isPartOf amblim:don-amendment .

amblim:general-provisions a prov:Entity ;
    dct:identifier "Articles 2, 3 and 10; applicability and transition provisions in amending acts" ;
    dct:description "Default edible/as-marketed basis is subject to Annex qualifications. Processed/compound products and transitional eligibility require additional facts. The applicable conditions are preserved in the source provisions."@en ;
    dct:isPartOf amblim:current-consolidation .

