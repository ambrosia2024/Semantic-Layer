amblim:processing-provisions a prov:Entity ;
    dct:identifier "Annex point 10, replacement of note 6" ;
    dct:description "First-stage processing excludes specified cleaning, sorting and drying operations insofar as the whole grain remains intact. Relevant when establishing the category's processing stage." ;
    dct:isPartOf amblim:processing-amendment .

# Annex I, section 1.4 — Deoxynivalenol (DON)

amblim:header-1-4 a prov:Entity ;
    dct:identifier "Annex I section 1.4, header and sum definition" ;
    dct:isPartOf amblim:current-consolidation ;
    prov:value "1.4 Deoxynivalenol Maximum level (μg/kg) Remarks" .

# Annex I, point 1.4.1

amblim:limit-1-4-1-2026-08-19 a amblink:ContaminantLimit ;
    dct:isVersionOf amblim:rule-1-4-1 ;
    dct:type amblim:legal-maximum ;
    amblink:regulatedHazard ambpath:deoxynivalenol ;
    amblink:appliesToCrop ambplant:barley ,
        ambplant:rye ,
        ambplant:soft-wheat ,
        ambplant:spelt ,
        ambplant:triticale ;
    amblink:foodCategory amblim:food-1-4-1 ;
    amblink:maximumLevel [
        a qudt:QuantityValue ;
        qudt:numericValue "1000"^^xsd:decimal ;
        qudt:unit unit:MicroGM-PER-KiloGM
    ] ;
    amblink:measurementBasis amblim:as-marketed ;
    dct:spatial <http://publications.europa.eu/resource/authority/country/EUR> ;
    dct:source amblim:provision-1-4-1 ;
    dct:created "2026-10-23"^^xsd:date .

amblim:food-1-4-1 a skos:Concept ;
    skos:prefLabel "Unprocessed cereal grains except products listed in 1.4.2 and 1.4.3"@en ;
    skos:definition "Unprocessed cereal grains except products listed in 1.4.2 and 1.4.3"@en ;
    skos:scopeNote "Except unprocessed maize grains intended to be processed by wet milling and except rice. The maximum level applies to unprocessed cereal grains placed on the market for first-stage processing ( 6 )."@en ;
    dct:source amblim:provision-1-4-1 .

amblim:provision-1-4-1 a prov:Entity ;
    dct:identifier "Annex I, point 1.4.1, maximum-level column and remarks" ;
