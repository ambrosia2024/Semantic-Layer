<https://w3id.org/ambrosia/pathogen-vocab#concept/mycotoxin/alternariol> a skos:Concept ;
    skos:inScheme <https://w3id.org/ambrosia/pathogen-vocab#scheme/mycotoxin> ;
    skos:prefLabel "Alternariol"@en ;
    skos:definition "A benzochromenone that is 6H-benzo[c]chromen-6-one which is substituted by a methyl group at position 1 and by hydroxy groups at positions 3, 7, and 9. It is the most important mycotoxin produced by the black mould Alternaria species, which are the most common mycoflora infecting small grain cereals worldwide."@en ,
        "chemical compound"@en ;
    dct:source "CHEBI" ,
        "FSKXO" ,
        "Wikidata" ;
    skos:exactMatch <http://purl.obolibrary.org/obo/CHEBI_64983> ,
        <http://semanticlookup.zbmed.de/km/fskxo/FSKXO_0000003576> ,
        <http://www.wikidata.org/entity/Q410677> .

