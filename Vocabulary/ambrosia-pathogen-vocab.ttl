    skos:inScheme <https://w3id.org/ambrosia/pathogen-vocab#scheme/mycotoxin> ;
    skos:prefLabel "Nivalenol"@en ;
    skos:definition "chemical compound"@en ;
    dct:source "CHEBI" ,
        "FSKXO" ,
